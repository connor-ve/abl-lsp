/* lint.p -- unused parameter / variable checks */
DEFINE INPUT PARAMETER pcUsed   AS CHARACTER NO-UNDO.
DEFINE INPUT PARAMETER pcUnused AS CHARACTER NO-UNDO.
DEFINE VARIABLE cUnused  AS CHARACTER NO-UNDO.
DEFINE VARIABLE cIgnored AS CHARACTER NO-UNDO.   /* lint-ignore unused-variable */
DEFINE VARIABLE hBuf     AS HANDLE    NO-UNDO.

MESSAGE pcUsed.
hBuf:BUFFER-RELEASE().

FUNCTION Twice RETURNS INTEGER (INPUT piValue AS INTEGER, INPUT piSpare AS INTEGER):
    RETURN piValue * 2.
END FUNCTION.

FUNCTION Later RETURNS LOGICAL (INPUT plFlag AS LOGICAL) FORWARD.

PROCEDURE Handler:
    // lint-ignore
    DEFINE INPUT PARAMETER pcEvent AS CHARACTER NO-UNDO.
END PROCEDURE.

FUNCTION Later RETURNS LOGICAL (INPUT plFlag AS LOGICAL):
    RETURN NOT plFlag.
END FUNCTION.
