{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OpenEdge ABL",
  "scopeName": "source.abl",
  "comment": "Generated by scripts/grammar.js from crates/core/src/keywords.rs. Do not edit by hand.",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#include"
    },
    {
      "include": "#annotation"
    },
    {
      "include": "#number"
    },
    {
      "include": "#type"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.abl",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comment"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.abl",
          "match": "//.*$"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.abl",
          "begin": "\"",
          "end": "\"(?::[RrLlCcTtUu]?\\d*)?",
          "patterns": [
            {
              "name": "constant.character.escape.abl",
              "match": "~."
            }
          ]
        },
        {
          "name": "string.quoted.single.abl",
          "begin": "'",
          "end": "'(?::[RrLlCcTtUu]?\\d*)?",
          "patterns": [
            {
              "name": "constant.character.escape.abl",
              "match": "~."
            }
          ]
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.abl",
          "match": "(?i)(&(?:GLOBAL-DEFINE|SCOPED-DEFINE|UNDEFINE))(?![\\w-])(?:\\s+([\\w-]+))?",
          "captures": {
            "1": {
              "name": "keyword.control.directive.abl"
            },
            "2": {
              "name": "entity.name.function.preprocessor.abl"
            }
          }
        },
        {
          "name": "keyword.control.directive.abl",
          "match": "(?i)&(?:GLOBAL-DEFINE|SCOPED-DEFINE|UNDEFINE|IF|ELSEIF|ELSE|ENDIF|THEN|MESSAGE|ANALYZE-SUSPEND|ANALYZE-RESUME)(?![\\w-])"
        },
        {
          "name": "variable.other.constant.preprocessor.abl",
          "match": "\\{&[\\w-]*\\}"
        }
      ]
    },
    "include": {
      "name": "meta.preprocessor.include.abl",
      "begin": "\\{(?![&\\d*])",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.include.begin.abl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.include.end.abl"
        }
      },
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#preprocessor"
        },
        {
          "name": "string.unquoted.include.abl",
          "match": "^[^\\s}]+|(?<=\\{)[^\\s}]+"
        }
      ]
    },
    "annotation": {
      "name": "storage.type.annotation.abl",
      "match": "(?i)(?<![\\w-])@[\\w-]+(?:\\.[\\w-]+)*"
    },
    "number": {
      "name": "constant.numeric.abl",
      "match": "(?<![\\w-])(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?)(?![\\w-])"
    },
    "type": {
      "name": "storage.type.abl",
      "match": "(?i)(?<![\\w-])(?:WIDGET-H(?:A(?:N(?:D(?:L(?:E)?)?)?)?)?|DATETIME-TZ|COM-HANDLE|CHAR(?:A(?:C(?:T(?:E(?:R)?)?)?)?)?|DATETIME|LONGCHAR|DEC(?:I(?:M(?:A(?:L)?)?)?)?|INT(?:E(?:G(?:E(?:R)?)?)?)?|LOG(?:I(?:C(?:A(?:L)?)?)?)?|HANDLE|MEMPTR|INT64|RECID|ROWID|BLOB|CLOB|DATE|VOID|RAW)(?![\\w-])"
    },
    "keyword": {
      "name": "keyword.other.abl",
      "match": "(?i)(?<![\\w-])(?:PACKAGE-PROTECTED|DYNAMIC-FUNCTION|NON-SERIALIZABLE|SOURCE-PROCEDURE|TARGET-PROCEDURE|CURRENT-CHANGED|PACKAGE-PRIVATE|USE-WIDGET-POOL|BUFFER-COMPARE|DATASET-HANDLE|EXCLUSIVE(?:-(?:L(?:O(?:C(?:K)?)?)?)?)?|THIS-PROCEDURE|ROUTINE-LEVEL|YES-NO-CANCEL|BEFORE-TABLE|BY-REFERENCE|COLUMN-LABEL|ERROR-STATUS|INPUT-OUTPUT|PROGRAM-NAME|RETURN-VALUE|SCREEN-VALUE|SERIALIZABLE|TABLE-HANDLE|VALID-HANDLE|VALID-OBJECT|BLOCK-LEVEL|BUFFER-COPY|CONSTRUCTOR|DATA-SOURCE|DYNAMIC-NEW|INFO(?:R(?:M(?:A(?:T(?:I(?:O(?:N)?)?)?)?)?)?)?|NUM-ENTRIES|SIDE-LABELS|THIS-OBJECT|TRANS(?:A(?:C(?:T(?:I(?:O(?:N)?)?)?)?)?)?|UNFORMATTED|ACCUM(?:U(?:L(?:A(?:T(?:E)?)?)?)?)?|DESC(?:E(?:N(?:D(?:I(?:N(?:G)?)?)?)?)?)?|DESTRUCTOR|DISCONNECT|IMPLEMENTS|PERSIST(?:E(?:N(?:T)?)?)?|SHARE(?:-(?:L(?:O(?:C(?:K)?)?)?)?)?|SUBSTITUTE|TEMP-TABLE|WORK-TAB(?:L(?:E)?)?|ALERT-BOX|AMBIG(?:U(?:O(?:U(?:S)?)?)?)?|ASC(?:E(?:N(?:D(?:I(?:N(?:G)?)?)?)?)?)?|AVAIL(?:A(?:B(?:L(?:E)?)?)?)?|CONNECTED|DELIMITER|GET-CLASS|INTERFACE|NO-LABELS|OTHERWISE|PARAM(?:E(?:T(?:E(?:R)?)?)?)?|PRESELECT|PROCE(?:D(?:U(?:R(?:E)?)?)?)?|PROTECTED|RECTANGLE|SIGNATURE|SUBSTR(?:I(?:N(?:G)?)?)?|USE-INDEX|ABS(?:O(?:L(?:U(?:T(?:E)?)?)?)?)?|ABSTRACT|ANYWHERE|BY-VALUE|CAN-FIND|CENTERED|CONTAINS|COPY-LOB|COUNT-OF|EXTERNAL|FIRST-OF|FUNCTION|INHERITS|NO-ERROR|OVERRIDE|PROPERTY|QUESTION|SUB-MENU|TRIGGERS|TRUNC(?:A(?:T(?:E)?)?)?|VALIDATE|VAR(?:I(?:A(?:B(?:L(?:E)?)?)?)?)?|WAIT-FOR|WORKFILE|BUTTONS|COMPILE|CONNECT|CURRENT|DATASET|DEFAULT|DEFINED|DISP(?:L(?:A(?:Y)?)?)?|EDITING|FINALLY|FORWARD|INIT(?:I(?:A(?:L)?)?)?|LAST-OF|MATCHES|MAX(?:I(?:M(?:U(?:M)?)?)?)?|MESSAGE|MIN(?:I(?:M(?:U(?:M)?)?)?)?|NO-LOCK|NO-UNDO|NO-WAIT|PRIMARY|PRIVATE|PROPATH|R-INDEX|RELEASE|REPLACE|RETURNS|SESSION|TRIGGER|TYPE-OF|VIEW-AS|WARNING|APPEND|ASSIGN|BEGINS|BROWSE|BUFFER|BUTTON|CAN-DO|COL(?:U(?:M(?:N)?)?)?|CREATE|DEF(?:I(?:N(?:E)?)?)?|DELETE|ENDKEY|EXCEPT|EXPORT|EXTENT|FIELDS|FORMAT|GLOBAL|IMPORT|LENGTH|LOCKED|LOOKUP|METHOD|MODULO|OUTPUT|PUBLIC|QUOTER|REPEAT|RETURN|SEARCH|SHARED|STATIC|STREAM|STRING|UNIQUE|UPDATE|WINDOW|YES-NO|APPLY|BREAK|CATCH|CLASS|CLEAR|CLOSE|EMPTY|ENTRY|ERROR|ETIME|EVENT|FALSE|FETCH|FIELD|FINAL|FIRST|FLAGS|FRAME|IMAGE|INDEX|INPUT|LABEL|LEAVE|MTIME|QUERY|ROUND|SUPER|TABLE|THROW|TITLE|TODAY|USING|VALUE|WHERE|WHILE|BELL|CAPS|CASE|CAST|DOWN|EACH|ELSE|ENUM|FILL|FIND|FORM|FROM|HIDE|INTO|LAST|LIKE|MENU|NEXT|OPEN|QUIT|SAVE|SELF|SIZE|SKIP|STOP|THEN|TIME|TRIM|TRUE|UNDO|VIEW|WHEN|WITH|ADD|ALL|AND|ANY|ASC|CHR|END|FOR|GET|NEW|NOT|NOW|PUT|ROW|RUN|SET|YES|AS|AT|BY|DO|EQ|GE|GT|IF|IN|IS|LC|LE|LT|NE|NO|OF|ON|OR|TO)(?![\\w-])"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.abl",
          "match": "<>|<=|>=|=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.abl",
          "match": "\\+|(?<![\\w-])-(?![\\w-])|\\*|/"
        }
      ]
    }
  }
}
