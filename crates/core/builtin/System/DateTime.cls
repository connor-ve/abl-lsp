/* .NET type. Stub written by abl from the public .NET API: common members only, for navigation and completion. .NET types map to ABL ones: String to CHARACTER, Int32 to INTEGER, Boolean to LOGICAL, DateTime to DATETIME. */
/* Maps to DATETIME: a .NET DateTime that comes back to ABL is a DATETIME value.
   Declared AS System.DateTime, it stays an object with these members. */
CLASS System.DateTime INHERITS System.Object FINAL:
    DEFINE PUBLIC STATIC PROPERTY Now AS DATETIME NO-UNDO GET.
    DEFINE PUBLIC STATIC PROPERTY UtcNow AS DATETIME NO-UNDO GET.
    DEFINE PUBLIC STATIC PROPERTY Today AS DATETIME NO-UNDO GET.
    DEFINE PUBLIC PROPERTY Year AS INTEGER NO-UNDO GET.
    DEFINE PUBLIC PROPERTY Month AS INTEGER NO-UNDO GET.
    DEFINE PUBLIC PROPERTY Day AS INTEGER NO-UNDO GET.
    DEFINE PUBLIC PROPERTY Hour AS INTEGER NO-UNDO GET.
    DEFINE PUBLIC PROPERTY Minute AS INTEGER NO-UNDO GET.
    DEFINE PUBLIC PROPERTY Second AS INTEGER NO-UNDO GET.
    DEFINE PUBLIC PROPERTY Millisecond AS INTEGER NO-UNDO GET.
    DEFINE PUBLIC PROPERTY DayOfYear AS INTEGER NO-UNDO GET.

    CONSTRUCTOR PUBLIC DateTime(INPUT year AS INTEGER, INPUT month AS INTEGER, INPUT day AS INTEGER):
    END CONSTRUCTOR.

    METHOD PUBLIC STATIC DATETIME Parse(INPUT s AS CHARACTER).
    METHOD PUBLIC STATIC INTEGER DaysInMonth(INPUT year AS INTEGER, INPUT month AS INTEGER).
    METHOD PUBLIC STATIC LOGICAL IsLeapYear(INPUT year AS INTEGER).
    METHOD PUBLIC DATETIME AddDays(INPUT value AS DECIMAL).
    METHOD PUBLIC DATETIME AddHours(INPUT value AS DECIMAL).
    METHOD PUBLIC DATETIME AddMinutes(INPUT value AS DECIMAL).
    METHOD PUBLIC DATETIME AddMonths(INPUT months AS INTEGER).
    METHOD PUBLIC DATETIME AddYears(INPUT value AS INTEGER).
    METHOD PUBLIC OVERRIDE CHARACTER ToString().
    /* Custom formats: dt:ToString("yyyy-MM-dd HH:mm"). */
    METHOD PUBLIC CHARACTER ToString(INPUT fmt AS CHARACTER).
END CLASS.
