/* .NET type. Stub written by abl from the public .NET API: common members only, for navigation and completion. .NET types map to ABL ones: String to CHARACTER, Int32 to INTEGER, Boolean to LOGICAL, DateTime to DATETIME. */
/* System.String maps to CHARACTER: the statics are called as System.String:IsNullOrEmpty(c). */
CLASS System.String INHERITS System.Object FINAL:
    DEFINE PUBLIC STATIC PROPERTY Empty AS CHARACTER NO-UNDO GET.
    DEFINE PUBLIC PROPERTY Length AS INTEGER NO-UNDO GET.

    METHOD PUBLIC STATIC LOGICAL IsNullOrEmpty(INPUT value AS CHARACTER).
    METHOD PUBLIC STATIC LOGICAL IsNullOrWhiteSpace(INPUT value AS CHARACTER).
    /* String:Format("{0} of {1}", a, b) */
    METHOD PUBLIC STATIC CHARACTER Format(INPUT fmt AS CHARACTER, INPUT arg0 AS System.Object).
    METHOD PUBLIC STATIC CHARACTER Format(INPUT fmt AS CHARACTER, INPUT arg0 AS System.Object, INPUT arg1 AS System.Object).
    METHOD PUBLIC STATIC CHARACTER Format(INPUT fmt AS CHARACTER, INPUT arg0 AS System.Object, INPUT arg1 AS System.Object, INPUT arg2 AS System.Object).
    METHOD PUBLIC STATIC CHARACTER Concat(INPUT str0 AS CHARACTER, INPUT str1 AS CHARACTER).
    METHOD PUBLIC STATIC INTEGER Compare(INPUT strA AS CHARACTER, INPUT strB AS CHARACTER).

    METHOD PUBLIC LOGICAL Contains(INPUT value AS CHARACTER).
    METHOD PUBLIC LOGICAL StartsWith(INPUT value AS CHARACTER).
    METHOD PUBLIC LOGICAL EndsWith(INPUT value AS CHARACTER).
    METHOD PUBLIC INTEGER IndexOf(INPUT value AS CHARACTER).
    METHOD PUBLIC INTEGER LastIndexOf(INPUT value AS CHARACTER).
    METHOD PUBLIC CHARACTER Substring(INPUT startIndex AS INTEGER).
    METHOD PUBLIC CHARACTER Substring(INPUT startIndex AS INTEGER, INPUT length AS INTEGER).
    METHOD PUBLIC CHARACTER Replace(INPUT oldValue AS CHARACTER, INPUT newValue AS CHARACTER).
    METHOD PUBLIC CHARACTER Insert(INPUT startIndex AS INTEGER, INPUT value AS CHARACTER).
    METHOD PUBLIC CHARACTER Remove(INPUT startIndex AS INTEGER).
    METHOD PUBLIC CHARACTER Trim().
    METHOD PUBLIC CHARACTER TrimStart().
    METHOD PUBLIC CHARACTER TrimEnd().
    METHOD PUBLIC CHARACTER ToUpper().
    METHOD PUBLIC CHARACTER ToLower().
    METHOD PUBLIC CHARACTER PadLeft(INPUT totalWidth AS INTEGER).
    METHOD PUBLIC CHARACTER PadRight(INPUT totalWidth AS INTEGER).
END CLASS.
