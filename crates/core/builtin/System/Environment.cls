/* .NET type. Stub written by abl from the public .NET API: common members only, for navigation and completion. .NET types map to ABL ones: String to CHARACTER, Int32 to INTEGER, Boolean to LOGICAL, DateTime to DATETIME. */
CLASS System.Environment INHERITS System.Object FINAL:
    DEFINE PUBLIC STATIC PROPERTY MachineName AS CHARACTER NO-UNDO GET.
    DEFINE PUBLIC STATIC PROPERTY UserName AS CHARACTER NO-UNDO GET.
    DEFINE PUBLIC STATIC PROPERTY UserDomainName AS CHARACTER NO-UNDO GET.
    DEFINE PUBLIC STATIC PROPERTY NewLine AS CHARACTER NO-UNDO GET.
    DEFINE PUBLIC STATIC PROPERTY CurrentDirectory AS CHARACTER NO-UNDO GET. SET.
    DEFINE PUBLIC STATIC PROPERTY ProcessorCount AS INTEGER NO-UNDO GET.
    DEFINE PUBLIC STATIC PROPERTY Is64BitProcess AS LOGICAL NO-UNDO GET.
    /* Milliseconds since the system started. */
    DEFINE PUBLIC STATIC PROPERTY TickCount AS INTEGER NO-UNDO GET.

    METHOD PUBLIC STATIC CHARACTER GetEnvironmentVariable(INPUT variable AS CHARACTER).
    METHOD PUBLIC STATIC VOID SetEnvironmentVariable(INPUT variable AS CHARACTER, INPUT value AS CHARACTER).
    METHOD PUBLIC STATIC CHARACTER ExpandEnvironmentVariables(INPUT name AS CHARACTER).
END CLASS.
