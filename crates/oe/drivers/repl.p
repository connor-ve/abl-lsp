/* abl-driver v1: repl */
/* Generated by abl. Connects back to abl on the port in the job file
   (ABL_JOB) and runs each piece of code it is sent, in this one session.
   Messages: an 8-digit byte length, then the text. Length 0 ends the session.
   Replies: "ok", "stop", or "error" followed by the messages, one per line. */
DEFINE VARIABLE cLine  AS CHARACTER NO-UNDO.
DEFINE VARIABLE cPort  AS CHARACTER NO-UNDO.
DEFINE VARIABLE cDir   AS CHARACTER NO-UNDO.
DEFINE VARIABLE cCode  AS CHARACTER NO-UNDO.
DEFINE VARIABLE cFile  AS CHARACTER NO-UNDO.
DEFINE VARIABLE cReply AS CHARACTER NO-UNDO.
DEFINE VARIABLE iLen   AS INTEGER   NO-UNDO.
DEFINE VARIABLE iSeq   AS INTEGER   NO-UNDO.
DEFINE VARIABLE i      AS INTEGER   NO-UNDO.
DEFINE VARIABLE hSock  AS HANDLE    NO-UNDO.
DEFINE VARIABLE mBuf   AS MEMPTR    NO-UNDO.

DEFINE STREAM sIn.
DEFINE STREAM sOut.

INPUT STREAM sIn FROM VALUE(OS-GETENV("ABL_JOB")).
REPEAT:
    IMPORT STREAM sIn UNFORMATTED cLine.
    CASE ENTRY(1, cLine, "~t"):
        WHEN "port" THEN cPort = ENTRY(2, cLine, "~t").
        WHEN "dir" THEN cDir = ENTRY(2, cLine, "~t").
    END CASE.
END.
INPUT STREAM sIn CLOSE.

CREATE SOCKET hSock.
hSock:CONNECT("-H 127.0.0.1 -S " + cPort).

REPEAT:
    SET-SIZE(mBuf) = 0.
    SET-SIZE(mBuf) = 8.
    hSock:READ(mBuf, 1, 8, READ-EXACT-NUM).
    IF hSock:BYTES-READ < 8 THEN LEAVE.
    iLen = INTEGER(GET-STRING(mBuf, 1, 8)).
    IF iLen = 0 THEN LEAVE.
    SET-SIZE(mBuf) = 0.
    SET-SIZE(mBuf) = iLen.
    hSock:READ(mBuf, 1, iLen, READ-EXACT-NUM).
    cCode = GET-STRING(mBuf, 1, iLen).

    /* A new file name each time, so nothing runs from a cached copy. */
    iSeq = iSeq + 1.
    cFile = cDir + "/abl_repl_" + STRING(iSeq) + ".p".
    OUTPUT STREAM sOut TO VALUE(cFile).
    PUT STREAM sOut UNFORMATTED cCode SKIP.
    OUTPUT STREAM sOut CLOSE.

    cReply = "stop".
    DO ON STOP UNDO, LEAVE ON ERROR UNDO, LEAVE:
        RUN VALUE(cFile).
        cReply = "ok".
        CATCH eErr AS Progress.Lang.Error:
            cReply = "error".
            DO i = 1 TO eErr:NumMessages:
                cReply = cReply + "~n" + eErr:GetMessage(i).
            END.
            IF eErr:NumMessages = 0 AND TYPE-OF(eErr, Progress.Lang.AppError) THEN
                cReply = cReply + "~n" + CAST(eErr, Progress.Lang.AppError):ReturnValue.
        END CATCH.
    END.
    OS-DELETE VALUE(cFile).

    SET-SIZE(mBuf) = 0.
    SET-SIZE(mBuf) = LENGTH(cReply, "RAW") + 8.
    PUT-STRING(mBuf, 1, 8) = STRING(LENGTH(cReply, "RAW"), "99999999").
    PUT-STRING(mBuf, 9, LENGTH(cReply, "RAW")) = cReply.
    hSock:WRITE(mBuf, 1, GET-SIZE(mBuf)).
END.
SET-SIZE(mBuf) = 0.
hSock:DISCONNECT() NO-ERROR.
DELETE OBJECT hSock.
QUIT.
