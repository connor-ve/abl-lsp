/* abl-driver v1: load-df */
/* Generated by abl. Loads the .df named in the job file (ABL_JOB) into the
   connected database with the Data Dictionary's prodict/load_df.p. */
DEFINE VARIABLE cLine   AS CHARACTER NO-UNDO.
DEFINE VARIABLE cResult AS CHARACTER NO-UNDO.
DEFINE VARIABLE cDf     AS CHARACTER NO-UNDO.
DEFINE VARIABLE cErrors AS CHARACTER NO-UNDO.
DEFINE VARIABLE cText   AS CHARACTER NO-UNDO.
DEFINE VARIABLE lFailed AS LOGICAL   NO-UNDO.
DEFINE VARIABLE i       AS INTEGER   NO-UNDO.

DEFINE STREAM sIn.
DEFINE STREAM sOut.

INPUT STREAM sIn FROM VALUE(OS-GETENV("ABL_JOB")).
REPEAT:
    IMPORT STREAM sIn UNFORMATTED cLine.
    CASE ENTRY(1, cLine, "~t"):
        WHEN "result" THEN cResult = ENTRY(2, cLine, "~t").
        WHEN "df" THEN cDf = ENTRY(2, cLine, "~t").
    END CASE.
END.
INPUT STREAM sIn CLOSE.

OUTPUT STREAM sOut TO VALUE(cResult).
DO ON ERROR UNDO, LEAVE ON STOP UNDO, LEAVE:
    RUN prodict/load_df.p (INPUT cDf).
    CATCH eErr AS Progress.Lang.Error:
        lFailed = TRUE.
        DO i = 1 TO eErr:NumMessages:
            PUT STREAM sOut UNFORMATTED
                "error~t" eErr:GetMessageNum(i) "~t"
                REPLACE(eErr:GetMessage(i), "~t", " ") SKIP.
        END.
    END CATCH.
END.
/* load_df.p writes the problems it finds to <logical name>.e. */
cErrors = SEARCH(LDBNAME(1) + ".e").
IF cErrors <> ? THEN DO:
    lFailed = TRUE.
    INPUT STREAM sIn FROM VALUE(cErrors).
    REPEAT:
        IMPORT STREAM sIn UNFORMATTED cLine.
        IF TRIM(cLine) <> "" THEN
            cText = cText + (IF cText = "" THEN "" ELSE " ") + TRIM(cLine).
    END.
    INPUT STREAM sIn CLOSE.
    PUT STREAM sOut UNFORMATTED "error~t0~t" REPLACE(cText, "~t", " ") SKIP.
END.
IF NOT lFailed THEN
    PUT STREAM sOut UNFORMATTED "done~t0~t0" SKIP.
OUTPUT STREAM sOut CLOSE.
QUIT.
