/* abl-driver v1: import */
/* Generated by abl. Loads the data file named in the job file (ABL_JOB)
   into a table in one transaction: one bad row and nothing is kept. */
DEFINE VARIABLE cLine    AS CHARACTER NO-UNDO.
DEFINE VARIABLE cResult  AS CHARACTER NO-UNDO.
DEFINE VARIABLE cData    AS CHARACTER NO-UNDO.
DEFINE VARIABLE cTable   AS CHARACTER NO-UNDO.
DEFINE VARIABLE lReplace AS LOGICAL   NO-UNDO.
DEFINE VARIABLE iRow     AS INTEGER   NO-UNDO.
DEFINE VARIABLE iDeleted AS INTEGER   NO-UNDO.
DEFINE VARIABLE iCols    AS INTEGER   NO-UNDO.
DEFINE VARIABLE hBuf     AS HANDLE    NO-UNDO.
DEFINE VARIABLE hQry     AS HANDLE    NO-UNDO.
DEFINE VARIABLE i        AS INTEGER   NO-UNDO.

DEFINE TEMP-TABLE ttCol NO-UNDO
    FIELD iSeq  AS INTEGER
    FIELD cName AS CHARACTER
    FIELD iExt  AS INTEGER
    INDEX ixSeq IS PRIMARY UNIQUE iSeq.

DEFINE STREAM sIn.
DEFINE STREAM sOut.

FUNCTION unescaped RETURNS CHARACTER (INPUT pcValue AS CHARACTER):
    DEFINE VARIABLE cOut  AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cChar AS CHARACTER NO-UNDO.
    DEFINE VARIABLE k     AS INTEGER   NO-UNDO.
    k = 1.
    DO WHILE k <= LENGTH(pcValue):
        cChar = SUBSTRING(pcValue, k, 1).
        IF cChar = CHR(92) AND k < LENGTH(pcValue) THEN DO:
            k = k + 1.
            cChar = SUBSTRING(pcValue, k, 1).
            CASE cChar:
                WHEN "t" THEN cChar = "~t".
                WHEN "n" THEN cChar = "~n".
                WHEN "r" THEN cChar = "~r".
            END CASE.
        END.
        cOut = cOut + cChar.
        k = k + 1.
    END.
    RETURN cOut.
END FUNCTION.

/* Assigns one value, converted to the field's type. */
PROCEDURE setValue:
    DEFINE INPUT PARAMETER phFld  AS HANDLE    NO-UNDO.
    DEFINE INPUT PARAMETER piExt  AS INTEGER   NO-UNDO.
    DEFINE INPUT PARAMETER pcText AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cText AS CHARACTER NO-UNDO.
    IF pcText = "?" THEN DO:
        IF piExt = 0 THEN phFld:BUFFER-VALUE = ?.
        ELSE phFld:BUFFER-VALUE(piExt) = ?.
        RETURN.
    END.
    cText = unescaped(SUBSTRING(pcText, 2)).
    IF piExt = 0 THEN
        CASE phFld:DATA-TYPE:
            WHEN "integer" THEN phFld:BUFFER-VALUE = INTEGER(cText).
            WHEN "int64" THEN phFld:BUFFER-VALUE = INT64(cText).
            WHEN "decimal" THEN phFld:BUFFER-VALUE = DECIMAL(cText).
            WHEN "logical" THEN phFld:BUFFER-VALUE = LOGICAL(cText).
            WHEN "date" THEN phFld:BUFFER-VALUE = DATE(cText).
            WHEN "datetime" THEN phFld:BUFFER-VALUE = DATETIME(cText).
            WHEN "datetime-tz" THEN phFld:BUFFER-VALUE = DATETIME-TZ(cText).
            OTHERWISE phFld:BUFFER-VALUE = cText.
        END CASE.
    ELSE
        CASE phFld:DATA-TYPE:
            WHEN "integer" THEN phFld:BUFFER-VALUE(piExt) = INTEGER(cText).
            WHEN "int64" THEN phFld:BUFFER-VALUE(piExt) = INT64(cText).
            WHEN "decimal" THEN phFld:BUFFER-VALUE(piExt) = DECIMAL(cText).
            WHEN "logical" THEN phFld:BUFFER-VALUE(piExt) = LOGICAL(cText).
            WHEN "date" THEN phFld:BUFFER-VALUE(piExt) = DATE(cText).
            WHEN "datetime" THEN phFld:BUFFER-VALUE(piExt) = DATETIME(cText).
            WHEN "datetime-tz" THEN phFld:BUFFER-VALUE(piExt) = DATETIME-TZ(cText).
            OTHERWISE phFld:BUFFER-VALUE(piExt) = cText.
        END CASE.
END PROCEDURE.

INPUT STREAM sIn FROM VALUE(OS-GETENV("ABL_JOB")).
REPEAT:
    IMPORT STREAM sIn UNFORMATTED cLine.
    CASE ENTRY(1, cLine, "~t"):
        WHEN "result" THEN cResult = ENTRY(2, cLine, "~t").
        WHEN "data" THEN cData = ENTRY(2, cLine, "~t").
        WHEN "table" THEN cTable = ENTRY(2, cLine, "~t").
        WHEN "replace" THEN lReplace = ENTRY(2, cLine, "~t") = "yes".
    END CASE.
END.
INPUT STREAM sIn CLOSE.

SESSION:DATE-FORMAT = "ymd".
SESSION:NUMERIC-FORMAT = "AMERICAN".

OUTPUT STREAM sOut TO VALUE(cResult).
DO TRANSACTION ON ERROR UNDO, LEAVE ON STOP UNDO, LEAVE:
    CREATE BUFFER hBuf FOR TABLE cTable.
    IF lReplace THEN DO:
        CREATE QUERY hQry.
        hQry:SET-BUFFERS(hBuf).
        hQry:QUERY-PREPARE("FOR EACH " + hBuf:NAME + " EXCLUSIVE-LOCK").
        hQry:QUERY-OPEN().
        REPEAT:
            hQry:GET-NEXT(EXCLUSIVE-LOCK).
            IF hQry:QUERY-OFF-END THEN LEAVE.
            hBuf:BUFFER-DELETE().
            iDeleted = iDeleted + 1.
        END.
        hQry:QUERY-CLOSE().
    END.
    INPUT STREAM sIn FROM VALUE(cData) CONVERT SOURCE "UTF-8".
    REPEAT ON ERROR UNDO, THROW:
        IMPORT STREAM sIn UNFORMATTED cLine.
        CASE ENTRY(1, cLine, "~t"):
            WHEN "field" THEN DO:
                iCols = iCols + 1.
                CREATE ttCol.
                ASSIGN ttCol.iSeq  = iCols
                       ttCol.cName = ENTRY(2, cLine, "~t")
                       ttCol.iExt  = INTEGER(ENTRY(3, cLine, "~t")).
            END.
            WHEN "row" THEN DO:
                iRow = iRow + 1.
                hBuf:BUFFER-CREATE().
                FOR EACH ttCol BY ttCol.iSeq:
                    RUN setValue (hBuf:BUFFER-FIELD(ttCol.cName), ttCol.iExt,
                                  ENTRY(ttCol.iSeq + 1, cLine, "~t")).
                END.
                hBuf:BUFFER-RELEASE().
            END.
        END CASE.
    END.
    INPUT STREAM sIn CLOSE.
    PUT STREAM sOut UNFORMATTED "done~t" iRow "~t" iDeleted SKIP.
    CATCH eErr AS Progress.Lang.Error:
        DO i = 1 TO eErr:NumMessages:
            PUT STREAM sOut UNFORMATTED
                "error~t" iRow "~t" REPLACE(eErr:GetMessage(i), "~t", " ") SKIP.
        END.
    END CATCH.
END.
IF VALID-HANDLE(hQry) THEN DELETE OBJECT hQry.
IF VALID-HANDLE(hBuf) THEN DELETE OBJECT hBuf.
OUTPUT STREAM sOut CLOSE.
QUIT.
