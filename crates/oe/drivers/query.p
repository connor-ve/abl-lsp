/* abl-driver v1: query */
/* Generated by abl. Runs the query described in the job file (ABL_JOB) and
   writes the rows to a data file. */
DEFINE VARIABLE cLine   AS CHARACTER NO-UNDO.
DEFINE VARIABLE cResult AS CHARACTER NO-UNDO.
DEFINE VARIABLE cOut    AS CHARACTER NO-UNDO.
DEFINE VARIABLE cTable  AS CHARACTER NO-UNDO.
DEFINE VARIABLE cPhrase AS CHARACTER NO-UNDO.
DEFINE VARIABLE cFields AS CHARACTER NO-UNDO.
DEFINE VARIABLE cRow    AS CHARACTER NO-UNDO.
DEFINE VARIABLE iMax    AS INTEGER   NO-UNDO.
DEFINE VARIABLE iRows   AS INTEGER   NO-UNDO.
DEFINE VARIABLE lMore   AS LOGICAL   NO-UNDO.
DEFINE VARIABLE hBuf    AS HANDLE    NO-UNDO.
DEFINE VARIABLE hQry    AS HANDLE    NO-UNDO.
DEFINE VARIABLE hFld    AS HANDLE    NO-UNDO.
DEFINE VARIABLE i       AS INTEGER   NO-UNDO.
DEFINE VARIABLE j       AS INTEGER   NO-UNDO.

DEFINE TEMP-TABLE ttCol NO-UNDO
    FIELD iSeq AS INTEGER
    FIELD hFld AS HANDLE
    FIELD iExt AS INTEGER
    INDEX ixSeq IS PRIMARY UNIQUE iSeq.

DEFINE STREAM sIn.
DEFINE STREAM sOut.
DEFINE STREAM sData.

FUNCTION escaped RETURNS CHARACTER (INPUT pcValue AS CHARACTER):
    DEFINE VARIABLE cBs AS CHARACTER NO-UNDO.
    cBs = CHR(92).
    RETURN REPLACE(REPLACE(REPLACE(REPLACE(pcValue, cBs, cBs + cBs),
        "~t", cBs + "t"), "~n", cBs + "n"), "~r", cBs + "r").
END FUNCTION.

/* One value in the data file format: ? or = and the escaped text. */
FUNCTION valueText RETURNS CHARACTER (INPUT phFld AS HANDLE, INPUT piExt AS INTEGER):
    DEFINE VARIABLE cValue AS CHARACTER NO-UNDO.
    DEFINE VARIABLE lDate  AS LOGICAL   NO-UNDO.
    lDate = LOOKUP(phFld:DATA-TYPE, "date,datetime,datetime-tz") > 0.
    IF piExt = 0 THEN DO:
        IF phFld:BUFFER-VALUE = ? THEN RETURN "?".
        cValue = (IF lDate THEN ISO-DATE(phFld:BUFFER-VALUE) ELSE STRING(phFld:BUFFER-VALUE)).
    END.
    ELSE DO:
        IF phFld:BUFFER-VALUE(piExt) = ? THEN RETURN "?".
        cValue = (IF lDate THEN ISO-DATE(phFld:BUFFER-VALUE(piExt)) ELSE STRING(phFld:BUFFER-VALUE(piExt))).
    END.
    RETURN "=" + escaped(cValue).
END FUNCTION.

INPUT STREAM sIn FROM VALUE(OS-GETENV("ABL_JOB")).
REPEAT:
    IMPORT STREAM sIn UNFORMATTED cLine.
    CASE ENTRY(1, cLine, "~t"):
        WHEN "result" THEN cResult = ENTRY(2, cLine, "~t").
        WHEN "out" THEN cOut = ENTRY(2, cLine, "~t").
        WHEN "table" THEN cTable = ENTRY(2, cLine, "~t").
        WHEN "phrase" THEN cPhrase = ENTRY(2, cLine, "~t").
        WHEN "max" THEN iMax = INTEGER(ENTRY(2, cLine, "~t")).
        WHEN "fields" THEN cFields = ENTRY(2, cLine, "~t").
    END CASE.
END.
INPUT STREAM sIn CLOSE.

SESSION:DATE-FORMAT = "ymd".
SESSION:NUMERIC-FORMAT = "AMERICAN".

OUTPUT STREAM sOut TO VALUE(cResult).
DO ON ERROR UNDO, LEAVE ON STOP UNDO, LEAVE:
    CREATE BUFFER hBuf FOR TABLE cTable.
    CREATE QUERY hQry.
    hQry:SET-BUFFERS(hBuf).
    hQry:QUERY-PREPARE("FOR EACH " + hBuf:NAME + " NO-LOCK " + cPhrase).
    hQry:QUERY-OPEN().

    OUTPUT STREAM sData TO VALUE(cOut) CONVERT TARGET "UTF-8".
    DO i = 1 TO hBuf:NUM-FIELDS:
        hFld = hBuf:BUFFER-FIELD(i).
        IF LOOKUP(hFld:DATA-TYPE, "blob,clob,raw") > 0 THEN NEXT.
        IF cFields <> "" AND LOOKUP(hFld:NAME, cFields) = 0 THEN NEXT.
        PUT STREAM sData UNFORMATTED
            "field~t" hFld:NAME "~t" hFld:DATA-TYPE "~t" hFld:EXTENT SKIP.
        IF hFld:EXTENT = 0 THEN DO:
            CREATE ttCol.
            ASSIGN ttCol.iSeq = i * 10000
                   ttCol.hFld = hFld.
        END.
        ELSE
            DO j = 1 TO hFld:EXTENT:
                CREATE ttCol.
                ASSIGN ttCol.iSeq = i * 10000 + j
                       ttCol.hFld = hFld
                       ttCol.iExt = j.
            END.
    END.
    REPEAT:
        hQry:GET-NEXT().
        IF hQry:QUERY-OFF-END THEN LEAVE.
        IF iMax > 0 AND iRows >= iMax THEN DO:
            lMore = TRUE.
            LEAVE.
        END.
        iRows = iRows + 1.
        cRow = "row".
        FOR EACH ttCol BY ttCol.iSeq:
            cRow = cRow + "~t" + valueText(ttCol.hFld, ttCol.iExt).
        END.
        PUT STREAM sData UNFORMATTED cRow SKIP.
    END.
    OUTPUT STREAM sData CLOSE.
    hQry:QUERY-CLOSE().
    PUT STREAM sOut UNFORMATTED "done~t" iRows "~t" (IF lMore THEN 1 ELSE 0) SKIP.
    CATCH eErr AS Progress.Lang.Error:
        DO i = 1 TO eErr:NumMessages:
            PUT STREAM sOut UNFORMATTED
                "error~t" eErr:GetMessageNum(i) "~t"
                REPLACE(eErr:GetMessage(i), "~t", " ") SKIP.
        END.
    END CATCH.
END.
IF VALID-HANDLE(hQry) THEN DELETE OBJECT hQry.
IF VALID-HANDLE(hBuf) THEN DELETE OBJECT hBuf.
OUTPUT STREAM sOut CLOSE.
QUIT.
