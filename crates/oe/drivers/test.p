/* abl-driver v1: test */
/* Generated by abl. Runs the unit tests listed in the job file (ABL_JOB):
   a class is created once with DYNAMIC-NEW and its methods are called with
   DYNAMIC-INVOKE; a .p is run persistent and its internal procedures are run
   in it. Each outcome is written to the result file as soon as it is known,
   so a test that ends the session (QUIT) loses only what comes after it. */
DEFINE VARIABLE cLine    AS CHARACTER NO-UNDO.
DEFINE VARIABLE cResult  AS CHARACTER NO-UNDO.
DEFINE VARIABLE cErr     AS CHARACTER NO-UNDO.
DEFINE VARIABLE cStatus  AS CHARACTER NO-UNDO.
DEFINE VARIABLE cMsg     AS CHARACTER NO-UNDO.
DEFINE VARIABLE cStack   AS CHARACTER NO-UNDO.
DEFINE VARIABLE cMsg2    AS CHARACTER NO-UNDO.
DEFINE VARIABLE iSuite   AS INTEGER   NO-UNDO.
DEFINE VARIABLE iSeq     AS INTEGER   NO-UNDO.
DEFINE VARIABLE iStart   AS INT64     NO-UNDO.
DEFINE VARIABLE oObj     AS Progress.Lang.Object NO-UNDO.
DEFINE VARIABLE hProc    AS HANDLE    NO-UNDO.

DEFINE TEMP-TABLE ttSuite NO-UNDO
    FIELD iSeq  AS INTEGER
    FIELD cId   AS CHARACTER
    FIELD cKind AS CHARACTER
    FIELD cName AS CHARACTER
    INDEX ixSeq IS PRIMARY UNIQUE iSeq.

DEFINE TEMP-TABLE ttCall NO-UNDO
    FIELD iSuite    AS INTEGER
    FIELD iSeq      AS INTEGER
    FIELD cRole     AS CHARACTER
    FIELD cId       AS CHARACTER
    FIELD cMethod   AS CHARACTER
    FIELD cExpected AS CHARACTER
    INDEX ixSeq IS PRIMARY UNIQUE iSuite iSeq.

DEFINE STREAM sIn.
DEFINE STREAM sOut.

FUNCTION escaped RETURNS CHARACTER (INPUT pcValue AS CHARACTER):
    DEFINE VARIABLE cBs AS CHARACTER NO-UNDO.
    cBs = CHR(92).
    RETURN REPLACE(REPLACE(REPLACE(REPLACE(pcValue, cBs, cBs + cBs),
        "~t", cBs + "t"), "~n", cBs + "n"), "~r", cBs + "r").
END FUNCTION.

/* IsA by name, false when the class isn't on the PROPATH. */
FUNCTION isA RETURNS LOGICAL (INPUT poErr AS Progress.Lang.Error, INPUT pcType AS CHARACTER):
    DEFINE VARIABLE lIs AS LOGICAL NO-UNDO.
    lIs = poErr:GetClass():IsA(pcType) NO-ERROR.
    RETURN lIs = TRUE.
END FUNCTION.

FUNCTION errorText RETURNS CHARACTER (INPUT poErr AS Progress.Lang.Error):
    DEFINE VARIABLE cText AS CHARACTER NO-UNDO.
    DEFINE VARIABLE i     AS INTEGER   NO-UNDO.
    DO i = 1 TO poErr:NumMessages:
        cText = cText + (IF cText = "" THEN "" ELSE "~n") + poErr:GetMessage(i).
    END.
    IF cText = "" AND TYPE-OF(poErr, Progress.Lang.AppError) THEN
        cText = CAST(poErr, Progress.Lang.AppError):ReturnValue.
    IF cText = "" OR cText = ? THEN
        cText = poErr:GetClass():TypeName.
    RETURN cText.
END FUNCTION.

/* Calls one method or internal procedure. Status: pass, fail (an assertion
   failed), error (anything else raised) or stop (a STOP condition). */
PROCEDURE invoke:
    DEFINE INPUT  PARAMETER pcMethod   AS CHARACTER NO-UNDO.
    DEFINE INPUT  PARAMETER pcExpected AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pcStatus   AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pcMsg      AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pcStack    AS CHARACTER NO-UNDO.

    ASSIGN pcStatus = "stop"
           pcMsg    = "a STOP condition ended it".
    DO ON ERROR UNDO, LEAVE ON STOP UNDO, LEAVE:
        IF VALID-OBJECT(oObj) THEN
            DYNAMIC-INVOKE(oObj, pcMethod).
        ELSE
            RUN VALUE(pcMethod) IN hProc.
        IF pcExpected <> "" THEN
            ASSIGN pcStatus = "fail"
                   pcMsg    = "expected " + pcExpected + " to be raised".
        ELSE
            ASSIGN pcStatus = "pass"
                   pcMsg    = "".
        CATCH eErr AS Progress.Lang.Error:
            ASSIGN pcMsg   = errorText(eErr)
                   pcStack = eErr:CallStack.
            IF pcStack = ? THEN pcStack = "".
            IF pcExpected <> "" AND isA(eErr, pcExpected) THEN
                ASSIGN pcStatus = "pass"
                       pcMsg    = ""
                       pcStack  = "".
            ELSE IF isA(eErr, "OpenEdge.Core.AssertionFailedError") THEN
                pcStatus = "fail".
            ELSE
                pcStatus = "error".
        END CATCH.
    END.
END PROCEDURE.

/* Runs every call of one role for the current suite; the first problem wins. */
PROCEDURE runRole:
    DEFINE INPUT  PARAMETER piSuite AS INTEGER   NO-UNDO.
    DEFINE INPUT  PARAMETER pcRole  AS CHARACTER NO-UNDO.
    DEFINE OUTPUT PARAMETER pcErr   AS CHARACTER NO-UNDO.
    DEFINE BUFFER bCall FOR ttCall.
    DEFINE VARIABLE cS AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cM AS CHARACTER NO-UNDO.
    DEFINE VARIABLE cT AS CHARACTER NO-UNDO.
    FOR EACH bCall WHERE bCall.iSuite = piSuite AND bCall.cRole = pcRole BY bCall.iSeq:
        RUN invoke (bCall.cMethod, "", OUTPUT cS, OUTPUT cM, OUTPUT cT).
        IF cS <> "pass" AND pcErr = "" THEN
            pcErr = pcRole + " " + bCall.cMethod + ": " + cM.
    END.
END PROCEDURE.

INPUT STREAM sIn FROM VALUE(OS-GETENV("ABL_JOB")).
REPEAT:
    IMPORT STREAM sIn UNFORMATTED cLine.
    CASE ENTRY(1, cLine, "~t"):
        WHEN "result" THEN cResult = ENTRY(2, cLine, "~t").
        WHEN "suite" THEN DO:
            ASSIGN iSuite = iSuite + 1
                   iSeq   = 0.
            CREATE ttSuite.
            ASSIGN ttSuite.iSeq  = iSuite
                   ttSuite.cId   = ENTRY(2, cLine, "~t")
                   ttSuite.cKind = ENTRY(3, cLine, "~t")
                   ttSuite.cName = ENTRY(4, cLine, "~t").
        END.
        WHEN "before" OR WHEN "after" OR WHEN "setup" OR WHEN "teardown" OR WHEN "test" THEN DO:
            iSeq = iSeq + 1.
            CREATE ttCall.
            ASSIGN ttCall.iSuite  = iSuite
                   ttCall.iSeq    = iSeq
                   ttCall.cRole   = ENTRY(1, cLine, "~t")
                   ttCall.cMethod = ENTRY(2, cLine, "~t").
            IF ttCall.cRole = "test" THEN
                ASSIGN ttCall.cId       = ENTRY(3, cLine, "~t")
                       ttCall.cExpected = ENTRY(4, cLine, "~t").
        END.
    END CASE.
END.
INPUT STREAM sIn CLOSE.

SESSION:ERROR-STACK-TRACE = TRUE.
OUTPUT STREAM sOut TO VALUE(cResult) UNBUFFERED.

FOR EACH ttSuite BY ttSuite.iSeq:
    ASSIGN oObj  = ?
           hProc = ?
           cErr  = "a STOP condition ended it".
    DO ON ERROR UNDO, LEAVE ON STOP UNDO, LEAVE:
        IF ttSuite.cKind = "cls" THEN
            oObj = DYNAMIC-NEW ttSuite.cName ().
        ELSE
            RUN VALUE(ttSuite.cName) PERSISTENT SET hProc.
        cErr = "".
        CATCH eErr AS Progress.Lang.Error:
            cErr = errorText(eErr).
        END CATCH.
    END.
    IF cErr = "" THEN
        RUN runRole (ttSuite.iSeq, "before", OUTPUT cErr).

    FOR EACH ttCall WHERE ttCall.iSuite = ttSuite.iSeq AND ttCall.cRole = "test" BY ttCall.iSeq:
        IF cErr <> "" THEN DO:
            PUT STREAM sOut UNFORMATTED
                "case~t" ttCall.cId "~terror~t0~t" escaped(cErr) "~t" SKIP.
            NEXT.
        END.
        ASSIGN cStack = ""
               iStart = ETIME.
        RUN runRole (ttSuite.iSeq, "setup", OUTPUT cMsg).
        IF cMsg <> "" THEN
            cStatus = "error".
        ELSE
            RUN invoke (ttCall.cMethod, ttCall.cExpected, OUTPUT cStatus, OUTPUT cMsg, OUTPUT cStack).
        RUN runRole (ttSuite.iSeq, "teardown", OUTPUT cMsg2).
        IF cMsg2 <> "" AND cStatus = "pass" THEN
            ASSIGN cStatus = "error"
                   cMsg    = cMsg2.
        IF cStatus = "stop" THEN cStatus = "error".
        PUT STREAM sOut UNFORMATTED
            "case~t" ttCall.cId "~t" cStatus "~t" (ETIME - iStart)
            "~t" escaped(cMsg) "~t" escaped(cStack) SKIP.
    END.

    IF cErr = "" THEN DO:
        RUN runRole (ttSuite.iSeq, "after", OUTPUT cErr).
        IF cErr <> "" THEN
            PUT STREAM sOut UNFORMATTED "suite~t" ttSuite.cId "~t" escaped(cErr) SKIP.
    END.
    IF VALID-OBJECT(oObj) THEN DELETE OBJECT oObj NO-ERROR.
    IF VALID-HANDLE(hProc) THEN DELETE PROCEDURE hProc NO-ERROR.
END.
OUTPUT STREAM sOut CLOSE.
QUIT.
